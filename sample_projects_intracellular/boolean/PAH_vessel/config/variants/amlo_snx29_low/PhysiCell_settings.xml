    <initial_conditions>
        <cell_positions enabled="true" type="csv">
            <folder>./config</folder>
            <filename>cells.csv</filename>
        </cell_positions>
    </initial_conditions>

    <user_parameters>
        <random_seed type="int" units="dimensionless" description="">0</random_seed>
        <node_to_visualize type="string" units="" description="">CREC_1</node_to_visualize>
        <pressure_half_max type="double" units="dimensionless" description="PhysiCell simple_pressure value at which cycle-entry rate is suppressed 2x (pressure-gated contact inhibition)">0.1</pressure_half_max>
        <pressure_hill_power type="double" units="dimensionless" description="Hill coefficient for the pressure-gating suppression of cycle entry">4.0</pressure_hill_power>
        <population_half_max type="double" units="dimensionless" description="total agent count at which cycle-entry rate is halved (global backstop cap)">2000.0</population_half_max>
        <population_hill_power type="double" units="dimensionless" description="Hill coefficient for the global population cap">8.0</population_hill_power>
        <lumen_radius type="double" units="micron" description="hard radial clamp for founder cells -- basement membrane/IEL">100.0</lumen_radius>
        <contraction_speed type="double" units="micron/min" description="CONTR_1=1 -> inward radial velocity added to Smooth_Muscle_Cell/Synthetic_SMC (reversible vasoconstriction proxy, uncalibrated placeholder)">0.0</contraction_speed>
        <amlo_periodic_dosing type="bool" units="dimensionless" description="enable once-daily oral PK AMLO dosing instead of constant EC secretion_rate">true</amlo_periodic_dosing>
        <amlo_pk_ka type="double" units="1/min" description="oral absorption rate constant, solved from --amlo-tmax-hours">0.0069003954</amlo_pk_ka>
        <amlo_pk_ke type="double" units="1/min" description="elimination rate constant, from --amlo-half-life-hours">0.00028881133</amlo_pk_ke>
        <amlo_dose_interval_min type="double" units="min" description="redosing interval (1440 = once daily)">1440.0</amlo_dose_interval_min>
        <amlo_pk_dose_amount type="double" units="dimensionless" description="dose scale = amlo_dose_mg/10 (linear PK assumption)">1</amlo_pk_dose_amount>
        <amlo_pk_ss_peak type="double" units="dimensionless" description="steady-state peak of the unit-dose (10mg reference) PK curve, used to normalize EC secretion_rate">2.6819505</amlo_pk_ss_peak>
        <amlo_pk_base_secretion_rate type="double" units="1/min" description="EC AMLO secretion_rate at steady-state peak for the 10mg reference dose">0.02</amlo_pk_base_secretion_rate>
    </user_parameters>
</PhysiCell_settings>
